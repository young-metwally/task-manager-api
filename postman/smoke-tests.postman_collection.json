  "item": [
    {
      "name": "US-01 Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "pm.test(\"Response has id\", function () {\r",
              "    var body = pm.response.json();\r",
              "    pm.expect(body.id).to.be.a(\"string\");\r",
              "    pm.collectionVariables.set(\"taskId\", body.id);\r",
              "});\r",
              "pm.test(\"Status is PENDING\", function () {\r",
              "    var body = pm.response.json();\r",
              "    pm.expect(body.status).to.equal(\"PENDING\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"title\": \"Buy groceries\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
